# =============================================================================
# LinkedIn Profile API — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# =============================================================================

# --- LinkedIn session cookies (from a THROWAWAY account) -----------------------
# Browser DevTools -> Application -> Cookies -> https://www.linkedin.com
#   li_at       : the session cookie value
#   JSESSIONID  : copy the value INCLUDING its surrounding double quotes, e.g. "ajax:1234567890"
#                 (the app strips the quotes itself to build the csrf-token header)
LI_AT=
LI_JSESSIONID=

# --- Outbound proxy (REQUIRED for any live LinkedIn call) ---------------------
# Must be a RESIDENTIAL or MOBILE proxy. Datacenter IPs get HTTP 999 from LinkedIn.
# Use socks5h:// (not socks5://) so DNS is resolved proxy-side.
#   socks5h://user:pass@host:port
#   http://user:pass@host:port
# The client FAILS CLOSED: with this unset, live fetches raise instead of leaking the host IP.
PROXY_URL=

# --- Auth for THIS api -------------------------------------------------------
# Callers must send `X-API-KEY: <value>`. Leave blank to disable auth (local dev only).
API_KEY=

# --- Tuning (all optional, defaults shown) -----------------------------------
CACHE_TTL_SECONDS=86400
IMPERSONATE=chrome
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3

# Primary strategy is the stable `profileView` endpoint. Set a decorationId
# captured from a live browser request to also enable the `dash/profiles`
# fallback. Leave blank to use profileView only.
PROFILE_VIEW_ENABLED=true
DASH_DECORATION_ID=
